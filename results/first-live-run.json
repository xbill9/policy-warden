    "kind": "rules",
    "proposed": [
      {
        "rule": {
          "text": "Every EBS volume must be attached to an instance.",
          "resource_type": "ec2:volume",
          "require": [
            {
              "field": "attrs.attached",
              "op": "eq",
              "value": true
            }
          ],
          "id": "R1"
        },
        "approved": true,
        "reason": "auto-approved (--approve all)"
      },
      {
        "rule": {
          "resource_type": "*",
          "require": [
            {
              "field": "tags.owner",
              "op": "exists"
            }
          ],
          "text": "Every EC2 instance and EBS volume must have an owner tag.",
          "id": "R2"
        },
        "approved": true,
        "reason": "auto-approved (--approve all)"
      },
      {
        "rule": {
          "resource_type": "ec2:security-group-rule",
          "violation_when": [
            {
              "field": "attrs.from_port",
              "op": "eq",
              "value": 22
            },
            {
              "field": "attrs.to_port",
              "op": "eq",
              "value": 22
            },
            {
              "field": "attrs.open_to_world",
              "op": "eq",
              "value": true
            }
          ],
          "text": "No security group rule may open port 22 to 0.0.0.0/0.",
          "id": "R3"
        },
        "approved": true,
        "reason": "auto-approved (--approve all)"
      },
      {
        "rule": {
          "resource_type": "s3:bucket",
          "violation_when": [
            {
              "field": "attrs.policy_is_public",
              "op": "eq",
              "value": true
            }
          ],
          "text": "No S3 bucket may be public.",
          "id": "R4"
        },
        "approved": true,
        "reason": "auto-approved (--approve all)"
      },
      {
        "rule": {
          "resource_type": "cost:service",
          "violation_when": [
            {
              "field": "attrs.month_to_date_usd",
              "op": "gt",
              "value": 50.0
            }
          ],
          "text": "No AWS service may cost more than $50 so far this month.",
          "id": "R5"
        },
        "approved": true,
        "reason": "auto-approved (--approve all)"
      }
